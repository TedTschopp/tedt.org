---
layout: null
sitemap:
  exclude: 'yes'
---
<?xml version="1.0" encoding="UTF-8"?>
{% if page.xsl %}
  <?xml-stylesheet type="text/xsl" href="{{ "/sitemap.xsl" | absolute_url }}"?>
{% endif %}
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- comment -%}
    Only emit canonical, indexable HTML documents. jekyll-redirect-from creates
    synthetic pages with redirect metadata; those aliases must never be search
    discovery URLs. The retired /prompts/ namespace is kept as static redirects
    and must likewise stay out of discovery. Work-in-progress and operational
    backfill pages are also deliberately kept out even when publicly reachable.
  {%- endcomment -%}
  {%- assign collections = site.collections | where_exp: 'collection', 'collection.output != false' -%}
  {%- for collection in collections -%}
    {%- for doc in collection.docs -%}
      {%- assign source_path = doc.relative_path | default: doc.path | downcase -%}
      {%- assign output_path = doc.url | downcase -%}
      {%- assign include_in_sitemap = true -%}

      {%- if doc.sitemap == false or doc.redirect_to or doc.noindex == true or doc.robots contains 'noindex' -%}
        {%- assign include_in_sitemap = false -%}
      {%- elsif output_path contains '/prompts/' -%}
        {%- assign include_in_sitemap = false -%}
      {%- elsif source_path contains '_work-in-progress/' or source_path contains '/work-in-progress/' or output_path contains '/work-in-progress/' -%}
        {%- assign include_in_sitemap = false -%}
      {%- elsif source_path contains 'backfill' or output_path contains 'backfill' -%}
        {%- assign include_in_sitemap = false -%}
      {%- endif -%}

      {%- if include_in_sitemap -%}
        {%- assign modified_at = doc.web_modified_at | default: doc.last_modified_at | default: doc.last_modified | default: doc.update | default: doc.date -%}
      <url>
        <loc>{{ doc.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
        {%- if modified_at %}
          <lastmod>{{ modified_at | date_to_xmlschema }}</lastmod>
        {%- endif %}
      </url>
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- for doc in site.html_pages -%}
    {%- assign source_path = doc.relative_path | default: doc.path | downcase -%}
    {%- assign output_path = doc.url | downcase -%}
    {%- assign include_in_sitemap = true -%}

    {%- if doc.sitemap == false or doc.redirect_to or doc.noindex == true or doc.robots contains 'noindex' -%}
      {%- assign include_in_sitemap = false -%}
    {%- elsif output_path contains '/prompts/' -%}
      {%- assign include_in_sitemap = false -%}
    {%- elsif output_path == '/404.html' or output_path == '/404/' -%}
      {%- assign include_in_sitemap = false -%}
    {%- elsif source_path contains '_work-in-progress/' or source_path contains '/work-in-progress/' or output_path contains '/work-in-progress/' -%}
      {%- assign include_in_sitemap = false -%}
    {%- elsif source_path contains 'backfill' or output_path contains 'backfill' -%}
      {%- assign include_in_sitemap = false -%}
    {%- endif -%}

    {%- if include_in_sitemap -%}
      {%- assign modified_at = doc.web_modified_at | default: doc.last_modified_at | default: doc.last_modified | default: doc.update | default: doc.date -%}
    <url>
      <loc>{{ doc.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
      {%- if modified_at %}
        <lastmod>{{ modified_at | date_to_xmlschema }}</lastmod>
      {%- endif %}
    </url>
    {%- endif -%}
  {%- endfor -%}
</urlset>
